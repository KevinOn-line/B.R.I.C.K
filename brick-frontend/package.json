{
  "name": "brick-frontend",
  "private": true,
  "version": "0.0.0",
  "description": "B.R.I.C.K. desktop security console with Raspberry Pi report receiver",
  "author": "B.R.I.C.K. Project",
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "desktop:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "package:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.1",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "vite": "^8.3.6",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.brick.securityconsole",
    "productName": "B.R.I.C.K. Security Console",
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "allowScripts": {
    "electron@45.3.2": true,
    "electron-winstaller@5.4.0": true
  }
}
